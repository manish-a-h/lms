# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/lms_db"

# ─── Auth / JWT ─────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-jwt-key"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES_DAYS="7"

# ─── App ────────────────────────────────────────────────────
# Local: localhost is OK. On Vercel, set APP_URL and NEXT_PUBLIC_APP_URL to https://your-domain
# (Project → Settings → Environment Variables). Do not paste localhost values into Vercel.
APP_URL="http://localhost:8000"
NEXTAUTH_URL="http://localhost:8000"
NEXT_PUBLIC_APP_URL="http://localhost:8000"
NODE_ENV="development"

# ─── Microsoft Teams / Entra ID SSO ─────────────────────────
# Vercel: add the same TEAMS_CLIENT_ID / TEAMS_CLIENT_SECRET / TEAMS_TENANT_ID as here
# (Project → Settings → Environment Variables → Production). Without them, Teams sign-in shows "not configured yet".
TEAMS_CLIENT_ID="your-entra-app-client-id"
TEAMS_CLIENT_SECRET="your-entra-app-client-secret"
TEAMS_TENANT_ID="organizations"
# Local: must match Entra redirect URI. Vercel: use https://your-domain/api/auth/callback (not localhost).
TEAMS_REDIRECT_URI="http://localhost:8000/api/auth/callback"
TEAMS_ALLOWED_DOMAINS=""
TEAMS_AUTO_PROVISION="true"
TEAMS_HR_EMAILS="hr1@example.com,hr2@example.com"
TEAMS_HR_WEBHOOK_URL=""

# ─── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="LMS System <no-reply@yourdomain.com>"

# ─── Cron / Scheduling ───────────────────────────────────────
CRON_SECRET="your-cron-secret-for-api-protection"